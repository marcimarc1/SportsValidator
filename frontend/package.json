{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@ffmpeg/core": "^0.8.3",
    "@ffmpeg/ffmpeg": "^0.9.4",
    "@fortawesome/fontawesome-svg-core": "^1.2.36",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@fortawesome/react-fontawesome": "^0.1.19",
    "@material-ui/core": "^4.11.3",
    "@mui/material": "^5.15.17",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^11.2.7",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "29.5.11",
    "@types/react-edit-text": "^4.4.1",
    "axios": "^1.6.7",
    "chart.js": "^3.9.1",
    "chartjs": "^0.3.24",
    "fabric": "^5.3.0",
    "http-proxy-middleware": "^2.0.6",
    "prettier": "3.2.4",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-edit-text": "^5.0.2",
    "react-router": "^5.2.0",
    "react-router-dom": "^5.2.0",
    "react-scripts": "4.0.1",
    "react-swipeable-views": "^0.14.0",
    "require-context": "^1.1.0",
    "testing-library": "^0.0.2",
    "web-vitals": "^0.2.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "jest",
    "eject": "react-scripts eject",
    "check": "prettier --check '**/*.js'",
    "reformat": "prettier --write '**/*.js'",
    "test:ci": "npm run test -- --testResultsProcessor=\"jest-junit\" --watchAll=false --ci --coverage"
  },
  "jest": {
    "transform": {
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.(css|less)$": "<rootDir>/src/tests/transforms/cssTransform.js",
      "\\.(svg)$": "<rootDir>/src/tests/transforms/svgTransform.js",
      "\\.(jpg|ico|jpeg|png|gif|eot|otf|webp|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/src/tests/transforms/fileTransform.js"
    },
    "setupFiles": [
      "./jestConfig.js"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "eqeqeq": "off",
      "no-fallthrough": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/plugin-proposal-private-property-in-object": "7.21.11",
    "@babel/preset-env": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@types/react-edit-text": "^4.4.1",
    "jest": "26.6.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-fetch-mock": "3.0.3",
    "jest-junit": "16.0.0",
    "react-test-renderer": "17.0.2"
  }
}
